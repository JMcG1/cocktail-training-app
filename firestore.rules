rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserIsActive() {
      return currentUserExists() && currentUserDoc().data.active == true;
    }

    function userRole() {
      return currentUserDoc().data.role;
    }

    function userVenueId() {
      return currentUserDoc().data.venueId;
    }

    function validRole(role) {
      return role == 'owner' || role == 'manager' || role == 'bartender';
    }

    function validInviteRole(role) {
      return role == 'manager' || role == 'bartender';
    }

    function bootstrapGrantId() {
      return request.resource.data.email;
    }

    function bootstrapGrantBefore() {
      return get(/databases/$(database)/documents/bootstrapGrants/$(bootstrapGrantId()));
    }

    function bootstrapGrantAfter() {
      return getAfter(/databases/$(database)/documents/bootstrapGrants/$(bootstrapGrantId()));
    }

    function bootstrapGrantIsRedeemable(grantDoc) {
      return grantDoc.exists() &&
        (grantDoc.data.email is string) &&
        grantDoc.data.email == bootstrapGrantId() &&
        grantDoc.data.disabled == false &&
        (!('usedAt' in grantDoc.data) || grantDoc.data.usedAt == null) &&
        (!('role' in grantDoc.data) || grantDoc.data.role == 'owner') &&
        (!('expiresAt' in grantDoc.data) ||
          (grantDoc.data.expiresAt is timestamp && grantDoc.data.expiresAt > request.time));
    }

    function isVenueUserForVenue(venueId) {
      return currentUserIsActive() &&
        validRole(userRole()) &&
        userVenueId() == venueId;
    }

    function isOwnerForVenue(venueId) {
      return isVenueUserForVenue(venueId) && userRole() == 'owner';
    }

    function isOperationalUserForVenue(venueId) {
      return isVenueUserForVenue(venueId) &&
        (userRole() == 'owner' || userRole() == 'manager');
    }

    function isInviteManagerForVenue(venueId) {
      return isOperationalUserForVenue(venueId);
    }

    function inviteBefore(venueId, inviteId) {
      return get(/databases/$(database)/documents/venues/$(venueId)/invites/$(inviteId));
    }

    function inviteAfter(venueId, inviteId) {
      return getAfter(/databases/$(database)/documents/venues/$(venueId)/invites/$(inviteId));
    }

    function inviteIsRedeemable(inviteDoc) {
      return inviteDoc.data.disabled == false &&
        inviteDoc.data.currentUses is int &&
        inviteDoc.data.maxUses is int &&
        inviteDoc.data.currentUses < inviteDoc.data.maxUses &&
        inviteDoc.data.expiresAt is timestamp &&
        inviteDoc.data.expiresAt > request.time &&
        validInviteRole(inviteDoc.data.role);
    }

    function publicInviteVisible(venueId) {
      return resource.data.venueId == venueId && inviteIsRedeemable(resource);
    }

    function bootstrapOwnerCreate(uid) {
      return request.auth.uid == uid &&
        request.resource.data.role == 'owner' &&
        request.resource.data.active == true &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.venueId is string &&
        request.resource.data.createdAt is string &&
        bootstrapGrantIsRedeemable(bootstrapGrantBefore()) &&
        bootstrapGrantAfter().exists() &&
        bootstrapGrantAfter().data.disabled == true &&
        bootstrapGrantAfter().data.usedByUid == uid &&
        bootstrapGrantAfter().data.usedAt is timestamp &&
        bootstrapGrantAfter().data.venueId == request.resource.data.venueId;
    }

    function userCreateMatchesInvite(uid) {
      return request.resource.data.role is string &&
        validInviteRole(request.resource.data.role) &&
        request.resource.data.inviteId is string &&
        request.resource.data.venueId is string &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.createdAt is string &&
        request.resource.data.active == true &&
        request.auth.uid == uid &&
        inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).exists() &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).exists() &&
        inviteIsRedeemable(inviteBefore(request.resource.data.venueId, request.resource.data.inviteId)) &&
        inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.role == request.resource.data.role &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.currentUses ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.currentUses + 1 &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.disabled ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.disabled &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.maxUses ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.maxUses &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.expiresAt ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.expiresAt &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.createdBy ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.createdBy &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.createdAt ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.createdAt &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.venueId ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.venueId &&
        inviteAfter(request.resource.data.venueId, request.resource.data.inviteId).data.role ==
          inviteBefore(request.resource.data.venueId, request.resource.data.inviteId).data.role;
    }

    function managerInviteUpdateIsSafe(venueId) {
      return request.resource.data.venueId == venueId &&
        resource.data.venueId == venueId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.maxUses == resource.data.maxUses &&
        request.resource.data.currentUses == resource.data.currentUses &&
        request.resource.data.disabled is bool;
    }

    function inviteRedemptionUpdateIsSafe(venueId, inviteId) {
      return request.resource.data.venueId == venueId &&
        resource.data.venueId == venueId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.maxUses == resource.data.maxUses &&
        request.resource.data.disabled == resource.data.disabled &&
        request.resource.data.currentUses == resource.data.currentUses + 1 &&
        inviteIsRedeemable(resource) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.venueId == venueId &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == resource.data.role &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteId == inviteId;
    }

    function isPublicQuizSession() {
      return resource.data.isActive == true;
    }

    function activeQuizSessionForVenue(venueId, sessionId) {
      return exists(/databases/$(database)/documents/venues/$(venueId)/quizSessions/$(sessionId)) &&
        get(/databases/$(database)/documents/venues/$(venueId)/quizSessions/$(sessionId)).data.isActive == true;
    }

    match /users/{uid} {
      allow read: if signedIn() &&
        (
          request.auth.uid == uid ||
          isOwnerForVenue(resource.data.venueId)
        );
      allow create: if signedIn() &&
        (
          bootstrapOwnerCreate(uid) ||
          userCreateMatchesInvite(uid)
        );
      allow update: if signedIn() &&
        (
          (
            request.auth.uid == uid &&
            request.resource.data.venueId == resource.data.venueId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.active == resource.data.active &&
            request.resource.data.inviteId == resource.data.inviteId
          ) ||
          (
            isOwnerForVenue(resource.data.venueId) &&
            (resource.data.role == 'manager' || resource.data.role == 'bartender') &&
            request.resource.data.venueId == resource.data.venueId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.inviteId == resource.data.inviteId
          )
        );
      allow delete: if false;
    }

    match /venues/{venueId} {
      allow create: if signedIn() &&
        bootstrapGrantIsRedeemable(bootstrapGrantBefore()) &&
        bootstrapGrantAfter().exists() &&
        bootstrapGrantAfter().data.disabled == true &&
        bootstrapGrantAfter().data.usedByUid == request.auth.uid &&
        bootstrapGrantAfter().data.venueId == venueId &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.active == true;
      allow read: if isVenueUserForVenue(venueId);
      allow update: if isOwnerForVenue(venueId);
      allow delete: if false;
    }

    match /bootstrapGrants/{grantId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if signedIn() &&
        grantId == request.resource.data.email &&
        grantId == resource.data.email &&
        bootstrapGrantIsRedeemable(resource) &&
        request.resource.data.disabled == true &&
        request.resource.data.usedByUid == request.auth.uid &&
        request.resource.data.usedAt is timestamp &&
        request.resource.data.venueId is string &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.expiresAt == resource.data.expiresAt;
      allow delete: if false;
    }

    match /cocktails/{cocktailId} {
      allow read: if currentUserIsActive();
      allow write: if currentUserIsActive() && userRole() == 'owner';
    }

    match /batches/{batchId} {
      allow read: if currentUserIsActive();
      allow write: if currentUserIsActive() && userRole() == 'owner';
    }

    match /cocktailIngredients/{ingredientId} {
      allow read: if currentUserIsActive();
      allow write: if currentUserIsActive() && userRole() == 'owner';
    }

    match /venues/{venueId}/invites/{inviteId} {
      allow get: if isInviteManagerForVenue(venueId) || publicInviteVisible(venueId);
      allow list: if isInviteManagerForVenue(venueId);
      allow create: if isInviteManagerForVenue(venueId) &&
        request.resource.data.venueId == venueId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.maxUses is int &&
        request.resource.data.maxUses > 0 &&
        request.resource.data.currentUses == 0 &&
        request.resource.data.disabled == false &&
        validInviteRole(request.resource.data.role);
      allow update: if
        (
          isInviteManagerForVenue(venueId) && managerInviteUpdateIsSafe(venueId)
        ) ||
        (
          signedIn() && inviteRedemptionUpdateIsSafe(venueId, inviteId)
        );
      allow delete: if false;
    }

    match /venues/{venueId}/recipes/{recipeId} {
      allow read: if isVenueUserForVenue(venueId);
      allow write: if isOwnerForVenue(venueId);
    }

    match /venues/{venueId}/batchRecipes/{batchRecipeId} {
      allow read: if isVenueUserForVenue(venueId);
      allow write: if isOwnerForVenue(venueId);
    }

    match /venues/{venueId}/ingredients/{ingredientId} {
      allow read: if isVenueUserForVenue(venueId);
      allow write: if isOwnerForVenue(venueId);
    }

    match /venues/{venueId}/recipeDrafts/{draftId} {
      allow read, write: if isOwnerForVenue(venueId);
    }

    match /venues/{venueId}/stockConcernSessions/{sessionId} {
      allow read, write: if isOperationalUserForVenue(venueId);
    }

    match /venues/{venueId}/bartenderSales/{salesId} {
      allow read, write: if isOperationalUserForVenue(venueId);
    }

    match /venues/{venueId}/quizSessions/{sessionId} {
      allow get: if isOperationalUserForVenue(venueId) || isPublicQuizSession();
      allow list: if isOperationalUserForVenue(venueId);
      allow write: if isOperationalUserForVenue(venueId);
    }

    match /venues/{venueId}/quizAttempts/{attemptId} {
      allow create: if activeQuizSessionForVenue(venueId, request.resource.data.sessionId) &&
        isVenueUserForVenue(venueId) &&
        request.resource.data.sessionId is string &&
        request.resource.data.bartenderName is string &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isOperationalUserForVenue(venueId) ||
        (
          isVenueUserForVenue(venueId) &&
          resource.data.userId == request.auth.uid
        );
      allow update, delete: if false;
    }

    match /venues/{venueId}/trendSummaries/{summaryId} {
      allow read, write: if isOperationalUserForVenue(venueId);
    }
  }
}
